# WP Hunter runtime credentials.
#
# Template: copy this file to .env and fill in what you need.
# wp-hunter reads environment variables only -- it does not parse .env itself.
# Either export them, or let systemd load the file with EnvironmentFile=
# (see the deploy section of README.md).
#
#   cp .env.example .env
#   chmod 600 .env
#   set -a; . ./.env; set +a
#
# Never commit the real .env; it is git-ignored.

# Telegram update notifications. Both values are required for delivery.
# Create a bot with @BotFather, then send it a message and read your chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: WPScan API token for `wp-hunter watch --vuln`.
# Free tier, daily quota: https://wpscan.com/
WPSCAN_API_TOKEN=

# Optional: override the config directory (default: ~/.config/wp-hunter,
# macOS: ~/Library/Application Support/wp-hunter, Windows: %APPDATA%\wp-hunter).
# WP_HUNTER_CONFIG_DIR=
